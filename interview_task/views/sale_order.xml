<odoo>
    <record id="view_order_form_inherit_serial" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.serial</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="serial_ids" widget="many2many_tags" domain="[('product_id', '=', product_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>
